{
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/public/favicon.png" },
    { "source": "/favicon.png", "destination": "/public/favicon.png" },

    { "source": "/icon-192.png", "destination": "/public/favicon.png" },
